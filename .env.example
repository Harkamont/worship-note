# Copy to ignored .env.local for local development; never commit a real key.
# .dev.vars takes precedence and disables .env/.env.local loading in Workers.
# Defaults: openai / https://api.openai.com/v1 / gpt-6-luna.
# AI_PROVIDER accepts openai or openai-compatible (Chat Completions).
# AI_BASE_URL is the server-controlled API prefix, normally ending in /v1.
# AI_OUTPUT_FORMAT accepts json_object, json_schema, or prompt.
# Compatible defaults to json_object; opt into json_schema only if supported.
# prompt omits response_format and requests schema-shaped JSON in the prompt.
# OpenAI Responses always uses strict json_schema.
# AI_REASONING_ENABLED accepts true or false; blank leaves the model default.
# Only OpenRouter's exact openrouter.ai host receives reasoning.enabled.
# OpenRouter routing requires parameter support and sorts providers by price.
# Set false for models whose optional reasoning is too slow or costly.
# AI_API_KEY is required for compatible providers; OPENAI_API_KEY is never reused.
# Z.ai GLM vision example (requests tested; no valid score output confirmed):
# AI_PROVIDER=openai-compatible
# AI_OUTPUT_FORMAT=prompt
# Configure the provider URL, vision model, and its own AI_API_KEY separately.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_ANNOTATION_MODEL=
AI_MUSICXML_MODEL=
# Direct MusicXML can use OpenRouter OpenAI Flex without fallback to higher-priced providers.
AI_MUSICXML_SERVICE_TIER=
# low, medium, high (default), xhigh, max; independent from AI_REASONING_ENABLED.
AI_MUSICXML_REASONING_EFFORT=
AI_OUTPUT_FORMAT=
AI_ANNOTATION_OUTPUT_FORMAT=
# Optional default/flex. flex is annotation-only and requires OpenRouter + openai/*.
# Flex explicitly routes only to openai/flex and disables higher-priced fallbacks.
AI_ANNOTATION_SERVICE_TIER=
AI_REASONING_ENABLED=
AI_API_KEY=
OPENAI_API_KEY=

# Optional dedicated OMR service. Leave blank on hosted Workers without a backend.
# The companion binds only to 127.0.0.1. Keep its token server-side and secret.
OMR_BASE_URL=
OMR_AUTH_TOKEN=
# Companion-only optional paths; defaults point to ../work/ relative to this repo.
OMR_PYTHON=
OMR_SOURCE=
OMR_JOBS_DIR=

# Full MusicXML local-OMR + text-only AI annotation (keeps notes unchanged)
AI_XML_ANNOTATION_MODEL=openai/gpt-6.1-sol
AI_XML_ANNOTATION_OUTPUT_FORMAT=json_schema
AI_XML_ANNOTATION_SERVICE_TIER=flex
AI_XML_ANNOTATION_REASONING_EFFORT=low

# Optional: selected 1–4 measure repair (defaults to the MusicXML model)
# AI_XML_REPAIR_MODEL=
# AI_XML_REPAIR_SERVICE_TIER=
# AI_XML_REPAIR_REASONING_EFFORT=low
